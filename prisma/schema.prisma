generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id                 String       @id @default(uuid())
  fullName           String
  phone              String?      @unique
  email              String?      @unique
  passwordHash       String
  referralCode       String       @unique
  referredById       String?
  role               String       @default("USER") // "USER" | "ADMIN"
  isVerified         Boolean      @default(false)
  verificationCode   String?
  verificationMethod String?      @default("PHONE") // "PHONE" | "EMAIL"
  phoneVerified      Boolean      @default(false)
  emailVerified      Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Self relation for referrals
  referredBy       User?        @relation("UserReferrals", fields: [referredById], references: [id])
  referralsMade    User[]       @relation("UserReferrals")

  // Relationships
  entries          DrawEntry[]
  payments         Payment[]
  referralTracking Referral[]   @relation("ReferrerTracker")
  refereeTracking  Referral[]   @relation("RefereeTracker")
  wonPrizes        Winner[]
  auditLogs        AuditLog[]
}

model Draw {
  id                     String      @id @default(uuid())
  title                  String
  slug                   String      @unique
  description            String
  entryFeePKR            Int         @default(10)
  startDate              DateTime    @default(now())
  endDate                DateTime
  status                 String      @default("ACTIVE") // "DRAFT" | "ACTIVE" | "PAUSED" | "CLOSED" | "COMPLETED"
  maxEntriesPerUser      Int         @default(50)
  maxTotalEntries        Int         @default(5000)
  totalEntriesCount      Int         @default(0)
  winnerSelectionMethod  String      @default("RANKING") // "RANKING" or "RANDOM_DRAW"
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  prizes                 Prize[]
  entries                DrawEntry[]
  payments               Payment[]
  winners                Winner[]
  referrals              Referral[]
}

model Prize {
  id               String      @id @default(uuid())
  drawId           String
  rank             Int         // 1: 1st Prize, 2: 2nd Prize, 3: 3rd Prize
  title            String
  tagline          String
  description      String
  estimatedValue   String      // e.g. "PKR 185,000"
  model3dType      String      // 'cd70', 'iphone17', 'android'
  imageUrl         String
  eligibilityRules String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  draw             Draw        @relation(fields: [drawId], references: [id], onDelete: Cascade)
  winners          Winner[]
}

model DrawEntry {
  id              String       @id @default(uuid())
  entryNumber     String       @unique // e.g. "10KK-ENT-984321"
  userId          String
  drawId          String
  entryType       String       @default("STANDARD") // "STANDARD" | "REFERRAL_BONUS"
  status          String       @default("ACTIVE")   // "ACTIVE" | "REVERSED" | "DISQUALIFIED"
  paymentId       String?
  referralId      String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  draw            Draw         @relation(fields: [drawId], references: [id], onDelete: Cascade)
  payment         Payment?     @relation(fields: [paymentId], references: [id])
  referral        Referral?    @relation(fields: [referralId], references: [id])

  @@index([userId, drawId])
}

model Referral {
  id                 String          @id @default(uuid())
  referrerId         String
  refereeId          String          @unique // each user can only be referred once
  drawId             String?
  status             String          @default("PENDING") // "PENDING" | "VERIFIED" | "REVERSED" | "FRAUDULENT"
  bonusEntryAwarded  Boolean         @default(false)
  bonusEntryId       String?
  ipAddress          String?
  fraudFlags         String?
  verifiedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  referrer           User            @relation("ReferrerTracker", fields: [referrerId], references: [id], onDelete: Cascade)
  referee            User            @relation("RefereeTracker", fields: [refereeId], references: [id], onDelete: Cascade)
  draw               Draw?           @relation(fields: [drawId], references: [id])
  bonusEntries       DrawEntry[]

  @@index([referrerId, status])
}

model Payment {
  id              String         @id @default(uuid())
  transactionRef  String         @unique // e.g. "JC-2027-10KK-XXXXX"
  idempotencyKey  String         @unique
  userId          String
  drawId          String
  amountPKR       Int            @default(10)
  method          String         @default("SIMULATED_WALLET") // "JAZZCASH" | "EASYPAISA" | "BANK_TRANSFER" | "SIMULATED_WALLET"
  status          String         @default("PENDING")          // "PENDING" | "SUCCESS" | "FAILED" | "REFUNDED"
  isSimulated     Boolean        @default(true)
  payerAccount    String?        // e.g. "0301-2345678"
  gatewayResponse String?        // JSON string of gateway data
  verifiedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  draw            Draw           @relation(fields: [drawId], references: [id], onDelete: Cascade)
  entries         DrawEntry[]
  refunds         Refund[]

  @@index([userId, status])
}

model Winner {
  id                     String    @id @default(uuid())
  drawId                 String
  prizeId                String
  userId                 String
  rank                   Int
  verifiedReferralCount  Int       @default(0)
  totalEligibleEntries   Int       @default(1)
  announcedAt            DateTime  @default(now())
  notes                  String?

  draw                   Draw      @relation(fields: [drawId], references: [id], onDelete: Cascade)
  prize                  Prize     @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Refund {
  id               String      @id @default(uuid())
  paymentId        String
  userId           String
  amountPKR        Int
  reason           String
  status           String      @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes       String?
  createdAt        DateTime    @default(now())
  processedAt      DateTime?

  payment          Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String    @id @default(uuid())
  adminId     String?
  action      String    // e.g. "LEGAL_FLAG_UPDATED", "DRAW_STATUS_CHANGED", "WINNER_PUBLISHED"
  targetType  String    // "DRAW", "PAYMENT", "SETTING", "USER"
  targetId    String?
  details     String    // JSON description or summary
  ipAddress   String?
  createdAt   DateTime  @default(now())

  admin       User?     @relation(fields: [adminId], references: [id])
}

model PlatformSetting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  category    String    @default("GENERAL") // LEGAL, PAYMENT, REFERRAL, SECURITY
  description String
  updatedAt   DateTime  @updatedAt
}
